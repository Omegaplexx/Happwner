<?xml version="1.0" encoding="utf-8"?>
<com.happwner.ui.FieldRow xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginBottom="@dimen/island_margin_bottom"
	android:gravity="center_vertical"
	android:orientation="horizontal">

	<com.google.android.material.textfield.TextInputLayout
		android:id="@+id/layoutHeaderValue"
		style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:saveEnabled="false"
		app:errorEnabled="false"
		app:helperTextEnabled="false">
		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/inputHeaderValue"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="@dimen/field_padding_vertical"
			android:paddingBottom="@dimen/field_padding_vertical"
			android:imeOptions="actionDone|flagNoExtractUi"
			android:inputType="text|textNoSuggestions"
			android:maxLines="1"
			android:saveEnabled="false"
			android:textColor="@color/text_input_color_selector" />
	</com.google.android.material.textfield.TextInputLayout>

	<ImageButton
		android:id="@+id/headerDelete"
		android:layout_width="@dimen/btn_icon_size"
		android:layout_height="@dimen/btn_icon_size"
		android:layout_marginStart="@dimen/spacing_small"
		android:background="@drawable/bg_icon_ripple"
		android:contentDescription="@string/cd_header_delete"
		android:src="@drawable/ic_delete"
		app:tint="@color/text_secondary" />
</com.happwner.ui.FieldRow>
