<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/happScreenBg">

<LinearLayout
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<View
		android:id="@+id/backdropStatusBar"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:background="?attr/happStatusBarBg" />

	<View
		android:layout_width="match_parent"
		android:layout_height="@dimen/toolbar_height"
		android:background="?attr/happToolbarBg" />
</LinearLayout>

<LinearLayout
	android:id="@+id/rootLayout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/happScreenBg"
	android:orientation="vertical">

	<View
		android:id="@+id/statusBarBackground"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:background="?attr/happStatusBarBg" />

	<com.google.android.material.appbar.AppBarLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content">

		<androidx.appcompat.widget.Toolbar
			android:id="@+id/toolbar"
			android:layout_width="match_parent"
			android:layout_height="@dimen/toolbar_height"
			android:background="?attr/happToolbarBg"
			app:title="@string/app_name"
			app:titleTextAppearance="@style/TextAppearance_Happwner_ToolbarTitle"
			app:titleTextColor="@color/toolbar_text"
			app:navigationIconTint="@color/toolbar_text"
			app:theme="@style/ThemeOverlay_Happwner_Toolbar">

			<ImageButton
				android:id="@+id/action_settings"
				android:layout_width="@dimen/toolbar_button"
				android:layout_height="@dimen/toolbar_button"
				android:padding="@dimen/toolbar_button_padding"
				android:scaleType="centerInside"
				android:layout_gravity="end"
				android:layout_marginEnd="8dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:src="@drawable/ic_settings"
				android:contentDescription="@string/title_settings"
				app:tint="@color/toolbar_text" />

		</androidx.appcompat.widget.Toolbar>

	</com.google.android.material.appbar.AppBarLayout>

	<include layout="@layout/main_content" />

</LinearLayout>

	<FrameLayout
		android:id="@+id/settingsFragmentContainer"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="?attr/happScreenBg"
		android:clickable="true"
		android:focusable="true"
		android:visibility="gone" />

</FrameLayout>
